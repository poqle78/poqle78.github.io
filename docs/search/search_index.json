i> <li>\u0412\u0435\u043a\u0442\u043e\u0440\u043d\u044b\u0435 \u0438 \u043c\u0430\u0442\u0440\u0438\u0447\u043d\u044b\u0435 \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0438</li> <li>\u0421\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0430\u043d\u0430\u043b\u0438\u0437 (\u0441\u0440\u0435\u0434\u043d\u0435\u0435, \u043c\u0435\u0434\u0438\u0430\u043d\u0430, std, \u043f\u0435\u0440\u0446\u0435\u043d\u0442\u0438\u043b\u0438)</li> <li>\u041d\u043e\u0440\u043c\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u044e \u0434\u0430\u043d\u043d\u044b\u0445</li> <li>\u0412\u0438\u0437\u0443\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u044e \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u043e\u0432</li> </ul>"},{"location":"labs/lr2/#_4","title":"\u0421\u0442\u0440\u0443\u043a\u0443\u0440\u0430 \u043f\u0440\u043e\u0435\u043a\u0442\u0430","text":""},{"location":"labs/lr2/#_5","title":"\u0420\u0435\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u044f","text":""},{"location":"labs/lr2/#_6","title":"\u0421\u043e\u0437\u0434\u0430\u043d\u0438\u0435 \u0438 \u043e\u0431\u0440\u0430\u0431\u043e\u0442\u043a\u0430 \u043c\u0430\u0441\u0441\u0438\u0432\u043e\u0432","text":"<pre><code>def create_vector():\n    return np.arange(10)\n\ndef create_matrix():\n    return np.random.rand(5, 5)\n\ndef reshape_vector(vec):\n    return vec.reshape(2, 5)\n\ndef transpose_matrix(mat):\n    return mat.T\n</code></pre>"},{"location":"labs/lr2/#_7","title":"\u0412\u0435\u043a\u0442\u043e\u0440\u043d\u044b\u0435 \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0438","text":"<pre><code>def vector_add(a, b):\n    return a + b\n\ndef scalar_multiply(vec, scalar):\n    return vec * scalar\n\ndef dot_product(a, b):\n    return np.dot(a, b)\n</code></pre>"},{"location":"labs/lr2/#_8","title":"\u041c\u0430\u0442\u0440\u0438\u0447\u043d\u044b\u0435 \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0438","text":"<pre><code>def matrix_multiply(a, b):\n    return a @ b\n\ndef matrix_determinant(a):\n    return np.linalg.det(a)\n\ndef matrix_inverse(a):\n    return np.linalg.inv(a)\n\ndef solve_linear_system(a, b):\n    return np.linalg.solve(a, b)\n</code></pre>"},{"location":"labs/lr2/#_9","title":"\u0421\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0430\u043d\u0430\u043b\u0438\u0437","text":"<pre><code>def load_dataset(path):\n    return pd.read_csv(path).to_numpy()\n\ndef statistical_analysis(data):\n    return {\n        'mean': np.mean(data),\n        'median': np.median(data),\n        'std': np.std(data),\n        'min': np.min(data),\n        'max': np.max(data),\n        '25_percentile': np.percentile(data, 25),\n        '75_percentile': np.percentile(data, 75)\n    }\n\ndef normalize_data(data):\n    return (data - np.min(data)) / (np.max(data) - np.min(data))\n</code></pre>"},{"location":"labs/lr2/#_10","title":"\u0412\u0438\u0437\u0443\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u044f","text":"<pre><code>def plot_histogram(data):\n    plt.figure()\n    plt.hist(data, bins=10)\n    plt.title(\"\u0413\u0438\u0441\u0442\u043e\u0433\u0440\u0430\u043c\u043c\u0430 \u043e\u0446\u0435\u043d\u043e\u043a\")\n    plt.savefig('plots/math_scores_histogram.png')\n    plt.close()\n\ndef plot_heatmap(matrix):\n    plt.figure()\n    sns.heatmap(matrix, annot=True)\n    plt.title(\"\u041a\u043e\u0440\u0440\u0435\u043b\u044f\u0446\u0438\u044f \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u043e\u0432\")\n    plt.savefig('plots/correlation_heatmap.png')\n    plt.close()\n\ndef plot_line(x, y):\n    plt.figure()\n    plt.plot(x, y)\n    plt.title(\"\u041e\u0446\u0435\u043d\u043a\u0438 \u0441\u0442\u0443\u0434\u0435\u043d\u0442\u043e\u0432\")\n    plt.savefig('plots/student_scores.png')\n    plt.close()\n</code></pre>"},{"location":"labs/lr2/#_11","title":"\u0413\u0440\u0430\u0444\u0438\u043a\u0438 \u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u044f","text":""},{"location":"labs/lr2/#_12","title":"\u0422\u0435\u0441\u0442\u044b","text":""},{"location":"labs/lr2/#_13","title":"\u0422\u0440\u0443\u0434\u043d\u043e\u0441\u0442\u0438 \u0432 \u0445\u043e\u0434\u0435 \u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u044f","text":""},{"location":"labs/lr2/#1","title":"1. \u041f\u0440\u043e\u0431\u043b\u0435\u043c\u044b \u0441 \u0440\u0430\u0437\u043c\u0435\u0440\u043d\u043e\u0441\u0442\u044f\u043c\u0438 \u043c\u0430\u0441\u0441\u0438\u0432\u043e\u0432","text":"<p>\u041f\u0440\u0438 \u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u0438 \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0439 \u0441\u043b\u043e\u0436\u0435\u043d\u0438\u044f, \u0443\u043c\u043d\u043e\u0436\u0435\u043d\u0438\u044f \u0438 \u0441\u043a\u0430\u043b\u044f\u0440\u043d\u043e\u0433\u043e \u043f\u0440\u043e\u0438\u0437\u0432\u0435\u0434\u0435\u043d\u0438\u044f \u0432\u043e\u0437\u043d\u0438\u043a\u0430\u043b\u0438 \u043e\u0448\u0438\u0431\u043a\u0438 \u0438\u0437-\u0437\u0430 \u043d\u0435\u0441\u043e\u0432\u043f\u0430\u0434\u0435\u043d\u0438\u044f \u0440\u0430\u0437\u043c\u0435\u0440\u043d\u043e\u0441\u0442\u0435\u0439 \u043c\u0430\u0441\u0441\u0438\u0432\u043e\u0432. \u0420\u0435\u0448\u0435\u043d\u0438\u0435: <pre><code>if a.shape[0] != a.shape[1]:\n    raise ValueError(f\"\u041c\u0430\u0442\u0440\u0438\u0446\u0430 \u0434\u043e\u043b\u0436\u043d\u0430 \u0431\u044b\u0442\u044c \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u043d\u043e\u0439, \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u0430 \u0444\u043e\u0440\u043c\u0430 {a.shape}\")\n</code></pre></p>"},{"location":"labs/lr2/#2_1","title":"2. \u0412\u044b\u0440\u043e\u0436\u0434\u0435\u043d\u043d\u044b\u0435 \u043c\u0430\u0442\u0440\u0438\u0446\u044b","text":"<p>\u041f\u0440\u0438 \u043f\u043e\u043f\u044b\u0442\u043a\u0435 \u043d\u0430\u0439\u0442\u0438 \u043e\u0431\u0440\u0430\u0442\u043d\u0443\u044e \u043c\u0430\u0442\u0440\u0438\u0446\u0443 \u0434\u043b\u044f \u0432\u044b\u0440\u043e\u0436\u0434\u0435\u043d\u043d\u043e\u0439 \u043c\u0430\u0442\u0440\u0438\u0446\u044b (\u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u0442\u0435\u043b\u044c = 0) \u0432\u043e\u0437\u043d\u0438\u043a\u0430\u043b\u0430 \u043e\u0448\u0438\u0431\u043a\u0430 \u0420\u0435\u0448\u0435\u043d\u0438\u0435: <pre><code>det = np.linalg.det(a)\n    if np.abs(det) &lt; 1e-10:\n        raise ValueError(f\"\u041c\u0430\u0442\u0440\u0438\u0446\u0430 \u0432\u044b\u0440\u043e\u0436\u0434\u0435\u043d\u0430 (\u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u0442\u0435\u043b\u044c = {det:.2e}). \u041e\u0431\u0440\u0430\u0442\u043d\u043e\u0439 \u043c\u0430\u0442\u0440\u0438\u0446\u044b \u043d\u0435 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442.\")\n</code></pre></p>"},{"location":"labs/lr2/#3","title":"3. \u041d\u0435\u043a\u0432\u0430\u0434\u0440\u0430\u0442\u043d\u044b\u0435 \u043c\u0430\u0442\u0440\u0438\u0446\u044b","text":"<p>\u0424\u0443\u043d\u043a\u0446\u0438\u0438 matrix_determinant() \u0438 matrix_inverse() \u0432\u044b\u0437\u044b\u0432\u0430\u043b\u0438\u0441\u044c \u0434\u043b\u044f \u043d\u0435\u043a\u0432\u0430\u0434\u0440\u0430\u0442\u043d\u044b\u0445 \u043c\u0430\u0442\u0440\u0438\u0446. \u0420\u0435\u0448\u0435\u043d\u0438\u0435:  <pre><code>if a.shape[0] != a.shape[1]:\n    raise ValueError(f\"\u041c\u0430\u0442\u0440\u0438\u0446\u0430 \u0434\u043e\u043b\u0436\u043d\u0430 \u0431\u044b\u0442\u044c \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u043d\u043e\u0439, \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u0430 \u0444\u043e\u0440\u043c\u0430 {a.shape}\")\n</code></pre></p>"},{"location":"labs/lr2/#4","title":"4. \u0414\u0435\u043b\u0435\u043d\u0438\u0435 \u043d\u0430 \u043d\u043e\u043b\u044c \u043f\u0440\u0438 \u043d\u043e\u0440\u043c\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438","text":"<p>\u0415\u0441\u043b\u0438 \u0432\u0441\u0435 \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f \u0432 \u043c\u0430\u0441\u0441\u0438\u0432\u0435 \u043e\u0434\u0438\u043d\u0430\u043a\u043e\u0432\u044b\u0435, \u0442\u043e max - min = 0, \u0447\u0442\u043e \u043f\u0440\u0438\u0432\u043e\u0434\u0438\u0442 \u043a \u0434\u0435\u043b\u0435\u043d\u0438\u044e \u043d\u0430 \u043d\u043e\u043b\u044c. \u0420\u0435\u0448\u0435\u043d\u0438\u0435: </p> <pre><code>if np.abs(max_val - min_val) &lt; 1e-10:\n    raise ValueError(f\"\u041d\u0435\u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e \u043d\u043e\u0440\u043c\u0430\u043b\u0438\u0437\u043e\u0432\u0430\u0442\u044c: \u0432\u0441\u0435 \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f \u043e\u0434\u0438\u043d\u0430\u043a\u043e\u0432\u044b\")\n</code></pre>"},{"location":"labs/lr2/#5","title":"5. \u041f\u0443\u0441\u0442\u044b\u0435 \u043c\u0430\u0441\u0441\u0438\u0432\u044b","text":"<p>\u0424\u0443\u043d\u043a\u0446\u0438\u0438 \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0430\u043d\u0430\u043b\u0438\u0437\u0430 \u0432\u044b\u0437\u044b\u0432\u0430\u043b\u0438\u0441\u044c \u0434\u043b\u044f \u043f\u0443\u0441\u0442\u044b\u0445 \u043c\u0430\u0441\u0441\u0438\u0432\u043e\u0432. \u0420\u0435\u0448\u0435\u043d\u0438\u0435:  <pre><code>if data.size == 0:\n    raise ValueError(\"\u041c\u0430\u0441\u0441\u0438\u0432 \u0434\u0430\u043d\u043d\u044b\u0445 \u043f\u0443\u0441\u0442\u043e\u0439\")\n</code></pre></p>"},{"location":"labs/lr2/#6","title":"6. \u041d\u0435\u0441\u043e\u0432\u043c\u0435\u0441\u0442\u0438\u043c\u044b\u0435 \u043c\u0430\u0442\u0440\u0438\u0446\u044b \u0434\u043b\u044f \u0443\u043c\u043d\u043e\u0436\u0435\u043d\u0438\u044f","text":"<p>\u0423\u043c\u043d\u043e\u0436\u0435\u043d\u0438\u0435 \u043c\u0430\u0442\u0440\u0438\u0446 \u0442\u0440\u0435\u0431\u0443\u0435\u0442, \u0447\u0442\u043e\u0431\u044b \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u0441\u0442\u043e\u043b\u0431\u0446\u043e\u0432 \u043f\u0435\u0440\u0432\u043e\u0439 \u043c\u0430\u0442\u0440\u0438\u0446\u044b \u0440\u0430\u0432\u043d\u044f\u043b\u043e\u0441\u044c \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u0443 \u0441\u0442\u0440\u043e\u043a \u0432\u0442\u043e\u0440\u043e\u0439. \u0420\u0435\u0448\u0435\u043d\u0438\u0435:  <pre><code>if a.shape[1] != b.shape[0]:\n    raise ValueError(f\"\u041d\u0435\u0441\u043e\u0432\u043c\u0435\u0441\u0442\u0438\u043c\u044b\u0435 \u0440\u0430\u0437\u043c\u0435\u0440\u043d\u043e\u0441\u0442\u0438 \u0434\u043b\u044f \u0443\u043c\u043d\u043e\u0436\u0435\u043d\u0438\u044f: {a.shape} \u0438 {b.shape}\")\n</code></pre></p>"},{"location":"labs/lr2/#_14","title":"\u0412\u044b\u0432\u043e\u0434","text":"<p>\u0412 \u0445\u043e\u0434\u0435 \u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u044f \u0434\u0430\u043d\u043d\u043e\u0439 \u043b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u043d\u043e\u0439 \u0440\u0430\u0431\u043e\u0442\u044b \u0431\u044b\u043b\u0438 \u0438\u0437\u0443\u0447\u0435\u043d\u044b \u043e\u0441\u043d\u043e\u0432\u043d\u044b\u0435 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u0438 \u0431\u0438\u0431\u043b\u0438\u043e\u0442\u0435\u043a\u0438 NumPy \u0434\u043b\u044f \u0447\u0438\u0441\u043b\u0435\u043d\u043d\u044b\u0445 \u0432\u044b\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u0439, \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0430\u043d\u0430\u043b\u0438\u0437\u0430 \u0438 \u0432\u0438\u0437\u0443\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438 \u0434\u0430\u043d\u043d\u044b\u0445. \u0418\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u0435 \u0432\u0435\u043a\u0442\u043e\u0440\u0438\u0437\u0430\u0446\u0438\u0438 NumPy \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u0435\u0442 \u043f\u0438\u0441\u0430\u0442\u044c \u043a\u043e\u043c\u043f\u0430\u043a\u0442\u043d\u044b\u0439 \u0438 \u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u044b\u0439 \u043a\u043e\u0434 \u0438 \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u0443\u0441\u043a\u043e\u0440\u044f\u0435\u0442 \u0432\u044b\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f \u043f\u0440\u0438 \u0440\u0430\u0431\u043e\u0442\u0435 \u0441 \u0431\u043e\u043b\u044c\u0448\u0438\u043c\u0438 \u043c\u0430\u0441\u0441\u0438\u0432\u0430\u043c\u0438 \u0434\u0430\u043d\u043d\u044b\u0445.</p>"}]}